# Copy this file to .env.local and fill in the values you have. The app
# works with none of these set - it falls back to a deterministic rule-based
# AI and a local "demo mode" for payments.

# --- Backend -----------------------------------------------------------------
# Where the Rust backend (backend/) is reachable from this Next.js process.
# Defaults to http://localhost:4000 for local dev (run `cargo run` in
# backend/ alongside `npm run dev` here). In production this points at
# wherever the backend is deployed (an EC2 box, another cloud, a college's
# own server) - it's a plain HTTP URL, nothing cloud-specific.
BACKEND_URL=http://localhost:4000

# --- AI (Groq) -------------------------------------------------------------
# Get a free key at https://console.groq.com/keys
# When unset, the AI assistant uses lib/ai/engine.ts's RuleBasedProvider
# instead of lib/ai/groq-provider.ts (same tools, same UI, just deterministic
# intent matching instead of a real LLM).
GROQ_API_KEY=
GROQ_MODEL=

# --- Payments (Razorpay) -----------------------------------------------------
# Not yet wired up on the Rust backend - fee payments always run in demo
# mode for now (see backend/src/routes/payments.rs).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
