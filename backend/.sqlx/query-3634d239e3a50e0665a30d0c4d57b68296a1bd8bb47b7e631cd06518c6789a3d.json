  "query": "\n        select se.id as section_id, c.id as course_id, c.code as course_code, c.name as course_name,\n               c.programme_id, c.semester, se.academic_year\n        from sections se\n        join courses c on c.id = se.course_id\n        where se.faculty_id = $1\n        ",
