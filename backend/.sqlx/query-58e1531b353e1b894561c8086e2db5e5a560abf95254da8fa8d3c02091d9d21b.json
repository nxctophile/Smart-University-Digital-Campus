  "query": "\n        select c.id as course_id, c.code as course_code, c.name as course_name, a.status, count(*) as \"count!\"\n        from attendance a\n        join courses c on c.id = a.course_id\n        where a.student_id = $1\n        group by c.id, c.code, c.name, a.status\n        ",
