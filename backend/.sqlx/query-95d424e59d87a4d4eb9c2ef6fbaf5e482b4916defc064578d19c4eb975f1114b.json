{
  "db_name": "PostgreSQL",
  "query": "\n        select bl.id, bl.due_at, bl.fine_amount, b.title, s.roll_number, s.first_name, s.last_name\n        from book_loans bl\n        join books b on b.id = bl.book_id\n        join students s on s.id = bl.student_id\n        where bl.status = 'overdue'\n        order by bl.due_at asc\n        limit 100\n        ",
